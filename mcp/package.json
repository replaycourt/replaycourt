{
  "name": "replaycourt-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that lets an AI agent hunt ReplayCourt bug bounties on NEAR inside a hard spending policy, without seeing a key",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "replaycourt-mcp": "src/server.ts"
  },
  "scripts": {
    "start": "node src/server.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "node demo/client-demo.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
